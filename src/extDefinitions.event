// -----------------------------------------
// Dedicated placements for randomized items
// -----------------------------------------

// The addresses for various vanilla locations for the apworld to re-point to

// Yes I could just let these auto-increment but I don't want them shifting on
// me if I place something in between

#define itemCastleDojo		$FF0000 // Sword Beam
#define itemFallsDojo		$FF0004 // Fast Split
#define itemHyliaDojo		$FF0008 // Peril Beam
#define itemTrilbyScrub		$FF000C // Bottle
#define itemCrenelScrub		$FF0010 // Grip Ring
#define itemCrenelDojo		$FF0014 // Roll Attack
#define itemSwampWaterfallDojo	$FF0018 // Fast Spin
#define itemSwampGraveDojo	$FF001C // Greatspin
#define itemPedSword1		$FF0020 // Red Sword
#define itemPedSword2		$FF0024 // Blue Sword
#define itemPedSword3		$FF0028 // Four Sword
#define itemReqReward		$FF002C // None / DHC Big Key / Random
#define itemTownDojo1		$FF0030 // Spin Attack
#define itemTownDojo2		$FF0034 // Rock Breaker
#define itemTownDojo3		$FF0038 // Dash Attack
#define itemTownDojo4		$FF003C // Down Thrust
#define itemCarlov		$FF0040 // Carlov Medal
#define itemNorthFieldDojo	$FF0044 // Long Spin

// Shop items are handled slightly differently
// they need to be part of map item data so they need to be the 3rd byte in a set of 20
#define itemStockwell80Item	$FF0053 // Big Wallet
#define itemStockwell300Item	$FF0073 // Boomerang
#define itemStockwell600Item	$FF0093 // Quiver
#define itemStockwellBackItem	$FF00B3 // Dog Food
#define itemStockwellBombItem	$FF00D3 // Bomb Bag

#define goron1Left		$FF00F0
#define goron1Middle		$FF00F2
#define goron1Right		$FF00F4
//spacer			$FF00F6
#define goron2Left		$FF00F8
#define goron2Middle		$FF00FA
#define goron2Right		$FF00FC
//spacer			$FF00FE
#define goron3Left		$FF0100
#define goron3Middle		$FF0102
#define goron3Right		$FF0104
//spacer			$FF0106
#define goron4Left		$FF0108
#define goron4Middle		$FF010A
#define goron4Right		$FF010C
//spacer			$FF010E
#define goron5Left		$FF0110
#define goron5Middle		$FF0112
#define goron5Right		$FF0114
#define goronMerchantCustomSets	$FF0116

// golden enemies follow the pattern (byte area, byte room, byte itemId, byte subId, short flag)
#define goldenDropTable		$FF0120

// Fusions data follows the pattern (byte itemId, byte subId, short spacer, word spacer)
// Table is indexed by the fusion id, making the following:
// 0x200-0x207: Nothing (there's no fusion id 0)
// 0x208-0x20F: Gold Fusion - Fused with Top Right Cloud
// 0x208-0x247: Gold Fusions
// 0x248-0x367: Red Fusions
// 0x368
#define fusionTable		$FF0200

#define multiplierTables	$FF0530
